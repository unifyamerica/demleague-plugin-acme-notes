{
  // The SPA UI (`./ui`): type-checked by vue-tsc, which also emits its declarations (Vite builds the code)
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist/ui-types",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.ui.tsbuildinfo",
    "types": []
  },
  "include": ["src/ui/**/*.ts", "src/ui/**/*.vue", "src/manifest.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
